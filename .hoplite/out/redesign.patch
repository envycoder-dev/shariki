diff --git a/static/landing.css b/static/landing.css
index d8a9b7e..4971120 100644
--- a/static/landing.css
+++ b/static/landing.css
@@ -1,168 +1,243 @@
-/* Public landing */
-.lp{min-height:100vh;background:var(--bg)}
-.lp-w{max-width:1120px;margin:0 auto;padding:0 32px;width:100%}
-.lp code{font-family:var(--mono);font-size:.88em;padding:1px 5px;border-radius:3px;background:var(--s2);border:1px solid var(--bd)}
+/* Public pages: the landing (static/landing.js) and the server-rendered pages (app/seo.py).
+   Paper, ink and one signal colour. Onest for text, JetBrains Mono for figures, labels and code. */
+.lp{min-height:100vh;background:var(--bg);--r:4px;--rule:var(--tx)}
+.lp-w{max-width:1200px;margin:0 auto;padding:0 40px;width:100%}
+.lp h1,.lp h2{text-wrap:balance}
+.lp code{font-family:var(--mono);font-size:.86em;padding:1px 5px;border-radius:3px;background:var(--s2);border:1px solid var(--bd)}
+.lp .btn,.lp .inp{border-radius:var(--r)}
+.lp-n{font:500 11.5px/1.4 var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--tx3)}
+.lp-empty{padding:28px 0;color:var(--tx2)}
 
 /* header */
-.lp-top{position:sticky;top:0;z-index:40;background:var(--bg);border-bottom:1px solid transparent}
+.lp-top{position:sticky;top:0;z-index:40;background:var(--bg);border-bottom:1px solid transparent;transition:border-color .2s}
 .lp-top.scrolled{border-bottom-color:var(--bd)}
-.lp-top-in{display:flex;align-items:center;gap:28px;height:60px}
-.lp-brand{padding:0!important}
-.lp-nav{display:flex;gap:22px;flex:1}
-.lp-nav a{color:var(--tx2);font-size:14px;padding:4px 0;border-bottom:1px solid transparent}
-.lp-nav a:hover{color:var(--tx)}
-.lp-nav a.on{color:var(--tx);border-bottom-color:var(--tx)}
-.lp-act{gap:8px;margin-left:auto}
+.lp-top-in{display:flex;align-items:center;gap:40px;height:64px}
+.lp-brand{padding:0!important;font-size:16px;letter-spacing:-.02em}
+.lp-nav{display:flex;gap:28px;flex:1}
+.lp-nav a{position:relative;color:var(--tx2);font-size:14.5px;padding:6px 0}
+.lp-nav a:hover,.lp-nav a.on{color:var(--tx)}
+.lp-nav a.on::after{content:"";position:absolute;left:0;right:0;bottom:-2px;height:2px;background:var(--accent)}
+.lp-act{display:flex;align-items:center;gap:10px;margin-left:auto}
+.lp-in{border:0;background:none;padding:6px 6px;color:var(--tx);font:500 14.5px var(--font);cursor:pointer}
+.lp-in:hover{color:var(--link)}
+.lp-key{margin-left:4px}
+[data-theme=dark] .lp-th .th-l,[data-theme=light] .lp-th .th-d{display:none}
 
 /* hero */
-.lp-hero{padding:72px 0 64px;border-bottom:1px solid var(--bd)}
