index 3cedbaf..b02fbb0 100644
--- a/static/privacy.html
+++ b/static/privacy.html
@@ -6,21 +6,20 @@
 <title>Политика конфиденциальности — {{SITE_NAME}}</title>
 <meta name="description" content="Политика конфиденциальности сервиса {{SITE_NAME}} ({{DOMAIN}})">
 <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
-<link rel="preconnect" href="https://fonts.googleapis.com">
