 <script>document.documentElement.dataset.theme = localStorage.getItem('theme') || 'light'</script>
 <style>
-:root{--font:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
-[data-theme=dark]{--bg:#141413;--s1:#1A1A19;--bd:#302F2C;--tx:#EDECE7;--tx2:#AAA8A0;--tx3:#78766F;--link:#78A9FF}
-[data-theme=light]{--bg:#FAF9F6;--s1:#FFFFFF;--bd:#E0DDD5;--tx:#191814;--tx2:#55534C;--tx3:#8A877E;--link:#0F62FE}
+:root{--font:"Onest",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
+[data-theme=dark]{--bg:#0F0F0D;--s1:#171714;--bd:#2D2C27;--tx:#F2EFE7;--tx2:#A9A59A;--tx3:#77736A;--link:#FF8A57}
+[data-theme=light]{--bg:#F3F1EB;--s1:#FDFCF9;--bd:#DBD6CB;--tx:#141310;--tx2:#58554D;--tx3:#87837A;--link:#B8360A}
 *{box-sizing:border-box}
 body{margin:0;background:var(--bg);color:var(--tx);font:15px/1.7 var(--font)}
 .wrap{max-width:800px;margin:0 auto;padding:0 20px}
 header{padding:28px 0 0}
 .top{display:flex;justify-content:space-between;align-items:center}
-.brand{font-weight:600;font-size:17px;text-decoration:none;color:var(--tx)}
-main{background:var(--s1);border:1px solid var(--bd);border-radius:10px;padding:36px 42px;margin:22px 0 36px}
-h1{font-size:23px;line-height:1.3;margin:0 0 6px}
+.brand{font-weight:600;font-size:17px;letter-spacing:-.02em;text-decoration:none;color:var(--tx)}
+main{background:var(--s1);border:1px solid var(--bd);border-radius:4px;padding:40px 44px;margin:22px 0 36px}
+h1{font-size:34px;line-height:1.1;letter-spacing:-.035em;margin:0 0 10px}
 .date{color:var(--tx3);font-size:13px;margin-bottom:26px}
 h2{font-size:16.5px;margin:26px 0 6px}
 p,li{color:var(--tx2);margin:6px 0}
