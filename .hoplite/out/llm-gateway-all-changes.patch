+# ---------------------------------------------------------------- Codex: /v1/responses over Anthropic
+r = ok(c.post("/v1/responses", headers=K, json={"model": "claude-sonnet-4-5", "instructions": "be brief", "input": [{"role": "user", "content": "hi"}]}))
